import heapq
import sys
def solve():
    input = sys.stdin.read
    data = input().split()
    
    if not data:
        return

    idx = 0
    t = int(data[idx])
    idx += 1
    out = []
    for _ in range(t):
        n = int(data[idx])
        m = int(data[idx+1])
        idx += 2
        graph = [{} for _ in range(n + 1)]
        
        for _ in range(m):
            u = int(data[idx])
            v = int(data[idx+1])
            w = int(data[idx+2])
            idx += 3
            
            if u == v:
                continue
            
            # Store only the minimum weight edge
            if v not in graph[u] or w < graph[u][v]:
                graph[u][v] = w
                graph[v][u] = w

        s = int(data[idx])
        idx += 1

        #Dijkstra's Algorithm
        INF = float('inf')
        dist = [INF] * (n + 1)
        dist[s] = 0
        
        pq = [(0, s)]
        
        while pq:
            d, u = heapq.heappop(pq)

            if d > dist[u]:
                continue

            for v, weight in graph[u].items():
                if dist[u] + weight < dist[v]:
                    dist[v] = dist[u] + weight
                    heapq.heappush(pq, (dist[v], v))
        res = []
        for i in range(1, n + 1):
            if i != s:
                res.append(str(dist[i]) if dist[i] != INF else "-1")

        out.append(" ".join(res))

    print("\n".join(out))

if __name__ == '__main__':
    solve()
